# Backend Environment Variables Template
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Generate high-entropy secret: node -e "require('crypto').randomBytes(64, (e,b)=>console.log(b.toString('hex')))"
JWT_SECRET=use_a_strong_random_string_of_at_least_32_characters_here
NODE_ENV=production

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# First admin setup security key
ADMIN_SETUP_SECRET=use_a_strong_secret_token_for_first_admin_setup

# WhatsApp Gateway Provider Configuration ('twilio' or 'meta')
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# Meta WhatsApp Cloud API (Alternative)
# META_WHATSAPP_TOKEN=your_meta_system_user_token
# META_PHONE_NUMBER_ID=your_phone_number_id

# Optional initial seed credentials for development
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=your_secure_password
