# Backend Environment Variables Template
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
# Generate with: node -e "require('crypto').randomBytes(64, (e,b)=>console.log(b.toString('hex')))"
JWT_SECRET=use_a_strong_random_string_here
NODE_ENV=production
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Optional setup secret to lock down initial /setup-admin endpoint
ADMIN_SETUP_SECRET=optional_strong_secret_for_first_admin
